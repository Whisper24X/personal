# Sandbox 配置文件
# 复制为 .env 并根据需要修改

# 容器名称（多实例时必须不同）
SANDBOX_NAME=yanxue-main-sandbox

# ============================================================
# 运行环境（自动检测）
# ============================================================
# 根据本机 IP 自动判断环境，无需手动设置 SANDBOX_ENV
# 匹配规则：本机 IP == SANDBOX_IP_XXX → 环境为 xxx
# 都不匹配 → 默认 development
#
# 也可以手动指定 SANDBOX_ENV 强制覆盖自动检测
#
SANDBOX_IP_TEST=10.8.8.152
#SANDBOX_IP_STAGE=
#SANDBOX_IP_PRODUCTION=
#SANDBOX_ENV=              # 留空自动检测，设值则强制使用

# ============================================================
# 访问地址（按环境配置）
# ============================================================
# 每个环境对应独立的外部访问地址
# 留空则自动拼接为 http://<本机IP>:<SANDBOX_PORT>
#
SANDBOX_BASE_URL_DEVELOPMENT=
SANDBOX_BASE_URL_TEST=http://device-test.local.yc345.tv
SANDBOX_BASE_URL_STAGE=http://device-stage.local.yc345.tv
SANDBOX_BASE_URL_PRODUCTION=http://device.local.yc345.tv

# Nginx 端口（Docker 端口映射，多实例时必须不同）
SANDBOX_PORT=8070

# 内存配置
SANDBOX_MEMORY=8g
SANDBOX_MEMORY_MIN=2g
