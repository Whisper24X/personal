# 即思即成（Mind2Build）环境配置模板
# 使用说明：
# 1. 复制此文件到项目根目录并重命名为 .env
# 2. 填入实际的配置值
# 3. 确保 .env 文件不被提交到版本控制

# ==================== LLM 配置 ====================

# 默认 LLM 提供商类型
# 可选值: openai, anthropic, gemini, zhipuai, qianfan, dashscope, ollama, ark
LLM_PROVIDER=ark

# 智谱AI (GLM) 配置
ZHIPUAI_API_KEY=b3796c2b64c34be692cc5ff35292b5f1.6dY0OHKL5BvRHQEn
ZHIPUAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPUAI_MODEL=glm-4-flash

# OpenAI 配置（可选）
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4-turbo

# Anthropic Claude 配置（可选）
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-opus-20240229

# Google Gemini 配置（可选）
# GOOGLE_API_KEY=AIza...
# GOOGLE_MODEL=gemini-pro

# 百度千帆配置（可选）
# QIANFAN_API_KEY=...
# QIANFAN_SECRET_KEY=...

# 阿里通义配置（可选）
# DASHSCOPE_API_KEY=...

# 字节跳动豆包 (ARK/Doubao) 配置（可选）
ARK_API_KEY=your-ark-api-key-here
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-1-5-pro-32k-250115

# Cursor Agent 配置（可选，用于Engineer角色）
# 启用Engineer使用Cursor Agent
ENGINEER_USE_CURSOR=false
# Cursor API Key
CURSOR_API_KEY=key_88e51ad5cb910171b88e3f837fa1c4a7d2af53f2cf4aab94211672ed2eff4862
# GitHub仓库URL（用于Cursor Agent）
CURSOR_REPOSITORY=https://github.com/your-org/your-repo
# 或者使用GITHUB_REPOSITORY环境变量
# GITHUB_REPOSITORY=https://github.com/your-org/your-repo
# Cursor Agent分支名称（可选，默认自动生成）
CURSOR_BRANCH_NAME=cursor/engineer-work
# 是否自动创建PR（默认true）
CURSOR_AUTO_CREATE_PR=true
# Cursor模型（可选，默认auto自动选择）
CURSOR_MODEL=auto
# WriteCode调试模式（默认false）
WRITE_CODE_DEBUG=false
# Deploy调试模式（默认false）
DEPLOY_DEBUG=false
# ImproveCode调试模式（默认false，调试时使用简单提示词测试循环机制）
IMPROVE_CODE_DEBUG=false

# Engineer角色自动编码配置
# 是否启用自动编码（默认false，不启用）
# false: 直接返回workspace的压缩包（不生成代码）

# true: 返回生成后代码的压缩包
ENGINEER_AUTO_CODE=false

# ==================== 数据库配置 ====================

# PostgreSQL 数据库连接
DATABASE_URL="postgresql://postgres:7to12pg12@10.8.8.110:5433/device_ainative?schema=public"

# 数据库连接池配置
DB_POOL_MIN=2
DB_POOL_MAX=10

# ==================== 服务配置 ====================

# 后端服务端口
BACKEND_PORT=3000

# 前端开发服务器端口
FRONTEND_PORT=5173

# 服务地址
BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

VITE_API_URL=http://device-test.local.yc345.tv

# ==================== 环境配置 ====================

# 运行环境: development, production, test
NODE_ENV=development

# 日志级别: debug, info, warn, error
LOG_LEVEL=debug

# ==================== 认证配置 ====================

# JWT Secret（生产环境请使用强密码）
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# ==================== 项目配置 ====================

# 工作区目录（生成项目的存放位置）
WORKSPACE_PATH=./workspace

# 最大项目数
MAX_PROJECTS=100

# ==================== LLM 使用配置 ====================

# 最大预算（美元）
MAX_BUDGET=10.0

# 最大重试次数
MAX_RETRY=3

# 请求超时时间（秒），建议设置为 300（5分钟）或更长，用于生成大型文档如 PRD
REQUEST_TIMEOUT=300

# 最大 Token 数（整体）
MAX_TOKENS=4000

# 每个章节的最大 Token 数（用于分步骤 PRD 生成）
MAX_TOKENS_PER_SECTION=32000

# 温度参数（0.0-1.0）
TEMPERATURE=0.7

# ==================== 工具配置 ====================

# 是否启用浏览器工具
ENABLE_BROWSER=true

# 是否启用终端工具
ENABLE_TERMINAL=false

# 是否启用代码执行
ENABLE_CODE_EXECUTION=false

# ==================== Stagehand 浏览器自动化配置 ====================

# 是否使用无头模式（false=显示浏览器窗口，true=无头模式）
# 默认 false，显示浏览器窗口以便观察执行过程
# 注意：AutomationExecution 会自动强制设置为有头模式，确保浏览器可见
STAGEHAND_HEADLESS=false

# Stagehand 详细日志级别（0=仅错误，1=info，2=debug）
# STAGEHAND_VERBOSE=1

# ==================== 安全配置 ====================

# 允许的域名（CORS）
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# 是否启用 HTTPS
ENABLE_HTTPS=false

# ==================== 监控配置 ====================

# 是否启用性能监控
ENABLE_MONITORING=true

# 是否启用错误追踪
ENABLE_ERROR_TRACKING=true

# ==================== Redis 配置（可选）====================

# Redis 连接（用于缓存和会话）
# REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=

# ==================== 其他配置 ====================

# 是否启用调试模式
DEBUG=false

# 文件上传大小限制（MB）
MAX_FILE_SIZE=10

# 会话超时时间（分钟）
SESSION_TIMEOUT=30

# ==================== 工作流执行器配置 ====================

# Stale Action 恢复阈值（分钟）
# 当检测到 action 在内存中但运行时间超过此阈值时，将其标记为 stale 并恢复
# 默认值: 30 分钟
STALE_ACTION_THRESHOLD_MINUTES=30

# Orphaned Executor 恢复阈值（分钟）
# 当检测到 session 不在内存中但 action 仍在运行（orphaned executor）时，使用此阈值
# 如果运行时间超过此阈值，自动恢复
# 默认值: 2 分钟（比 stale action 更短，因为 orphaned executor 需要更快恢复）
ORPHANED_EXECUTOR_THRESHOLD_MINUTES=2

# ==================== 执行模式配置 ====================
# 
# 系统支持两种执行模式：
# - llm: 使用大模型 API 执行（默认，向后兼容）
# - cli: 使用命令行工具执行（如 Cursor CLI, Aider）
#
# 配置优先级：角色配置 > 环境变量 > 默认(llm)

# 默认执行模式
# 可选值: llm, cli
DEFAULT_EXECUTOR_MODE=llm

# 默认 CLI 提供商
# 可选值: cursor, aider, cline, custom
DEFAULT_CLI_PROVIDER=cursor

# Cursor CLI 配置
CURSOR_CLI_MODEL=composer-1
CURSOR_CLI_TIMEOUT=3600000

# ==================== Cursor CLI 流式进度跟踪配置 ====================

# 是否启用流式进度跟踪（默认 false）
# 启用后，Cursor CLI 将使用 stream-json 格式输出，实时记录进度到日志
CURSOR_CLI_ENABLE_STREAM_PROGRESS=false

# 输出格式（默认 text）
# 可选值: text, json, stream-json
# stream-json: 每行一个 JSON 对象，包含实时进度信息
CURSOR_CLI_OUTPUT_FORMAT=text

# 是否启用增量流式传输（默认 false）
# 启用后，会实时流式传输变更内容
CURSOR_CLI_STREAM_PARTIAL_OUTPUT=false

# 角色级别流式进度跟踪配置（可选）
# 格式: ROLE_{角色名大写}_CLI_ENABLE_STREAM_PROGRESS=true|false
# 格式: ROLE_{角色名大写}_CLI_OUTPUT_FORMAT=text|json|stream-json
# 格式: ROLE_{角色名大写}_CLI_STREAM_PARTIAL_OUTPUT=true|false
# 示例:
# ROLE_ENGINEER_CLI_ENABLE_STREAM_PROGRESS=true
# ROLE_ENGINEER_CLI_OUTPUT_FORMAT=stream-json
# ROLE_ENGINEER_CLI_STREAM_PARTIAL_OUTPUT=true

# 角色级别执行模式配置（可选）
# 格式: ROLE_{角色名大写}_EXECUTOR_MODE=llm|cli
# 示例:
# ROLE_PRODUCTMANAGER_EXECUTOR_MODE=llm
# ROLE_ARCHITECT_EXECUTOR_MODE=llm
# ROLE_ENGINEER_EXECUTOR_MODE=cli
# ROLE_QAENGINEER_EXECUTOR_MODE=llm

# 角色级别 CLI 提供商配置（可选）
# 格式: ROLE_{角色名大写}_CLI_PROVIDER=cursor|aider|cline|custom
# 示例:
# ROLE_ENGINEER_CLI_PROVIDER=cursor
# ROLE_ARCHITECT_CLI_PROVIDER=aider

# 角色级别 CLI 模型配置（可选）
# 格式: ROLE_{角色名大写}_CLI_MODEL=模型名称
# 示例:
# ROLE_ENGINEER_CLI_MODEL=composer-1

# ==================== 容器化配置（可选）====================

# 容器环境标识
# 设置此变量表示在容器环境中运行
# CONTAINER_WORKSPACE_ROOT=/workspace

# 本地开发模式标识
# LOCAL_DEV=true
