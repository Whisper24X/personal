# 即思即成（Mind2Build）环境配置模板
# 使用说明：
# 1. 复制此文件到项目根目录并重命名为 .env
# 2. 填入实际的配置值
# 3. 确保 .env 文件不被提交到版本控制

# ==================== LLM 配置 ====================

# 默认 LLM 提供商类型
# 可选值: openai, anthropic, gemini, zhipuai, qianfan, dashscope, ollama, ark
LLM_PROVIDER=ark

# 智谱AI (GLM) 配置
ZHIPUAI_API_KEY=b3796c2b64c34be692cc5ff35292b5f1.6dY0OHKL5BvRHQEn
ZHIPUAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPUAI_MODEL=glm-4-flash

# OpenAI 配置（可选）
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4-turbo

# Anthropic Claude 配置（可选）
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-opus-20240229

# Google Gemini 配置（可选）
# GOOGLE_API_KEY=AIza...
# GOOGLE_MODEL=gemini-pro

# 百度千帆配置（可选）
# QIANFAN_API_KEY=...
# QIANFAN_SECRET_KEY=...

# 阿里通义配置（可选）
# DASHSCOPE_API_KEY=...

# 字节跳动豆包 (ARK/Doubao) 配置（可选）
ARK_API_KEY=your-ark-api-key-here
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-1-5-pro-32k-250115

# Cursor Agent 配置（可选，用于Engineer角色）
# 启用Engineer使用Cursor Agent
ENGINEER_USE_CURSOR=false
# Cursor API Key
CURSOR_API_KEY=key_a92ddf19fb19678761a887bc0dc43eed735db8c3b4a19ad120f8d43538893056
# GitHub仓库URL（用于Cursor Agent）
CURSOR_REPOSITORY=https://github.com/your-org/your-repo
# 或者使用GITHUB_REPOSITORY环境变量
# GITHUB_REPOSITORY=https://github.com/your-org/your-repo
# Cursor Agent分支名称（可选，默认自动生成）
CURSOR_BRANCH_NAME=cursor/engineer-work
# 是否自动创建PR（默认true）
CURSOR_AUTO_CREATE_PR=true
# Cursor模型（可选，默认auto自动选择）
CURSOR_MODEL=auto

# Engineer角色自动编码配置
# 是否启用自动编码（默认false，不启用）
# false: 直接返回workspace的压缩包（不生成代码）
# true: 返回生成后代码的压缩包
ENGINEER_AUTO_CODE=false

# ==================== 数据库配置 ====================

# PostgreSQL 数据库连接
DATABASE_URL="postgresql://postgres:7to12pg12@10.8.8.110:5433/device_ainative?schema=public"

# 数据库连接池配置
DB_POOL_MIN=2
DB_POOL_MAX=10

# ==================== 服务配置 ====================

# 后端服务端口
BACKEND_PORT=3000

# 前端开发服务器端口
FRONTEND_PORT=5173

# 服务地址
BACKEND_URL=http://device-test.local.yc345.tv
FRONTEND_URL=http://localhost:5173

# ==================== 环境配置 ====================

# 运行环境: development, production, test
NODE_ENV=development

# 日志级别: debug, info, warn, error
LOG_LEVEL=debug

# ==================== 认证配置 ====================

# JWT Secret（生产环境请使用强密码）
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# ==================== 项目配置 ====================

# 工作区目录（生成项目的存放位置）
WORKSPACE_PATH=./workspace

# 最大项目数
MAX_PROJECTS=100

# ==================== LLM 使用配置 ====================

# 最大预算（美元）
MAX_BUDGET=10.0

# 最大重试次数
MAX_RETRY=3

# 请求超时时间（秒），建议设置为 300（5分钟）或更长，用于生成大型文档如 PRD
REQUEST_TIMEOUT=300

# 最大 Token 数（整体）
MAX_TOKENS=4000

# 每个章节的最大 Token 数（用于分步骤 PRD 生成）
MAX_TOKENS_PER_SECTION=32000

# 温度参数（0.0-1.0）
TEMPERATURE=0.7

# ==================== 工具配置 ====================

# 是否启用浏览器工具
ENABLE_BROWSER=true

# 是否启用终端工具
ENABLE_TERMINAL=false

# 是否启用代码执行
ENABLE_CODE_EXECUTION=false

# ==================== 安全配置 ====================

# 允许的域名（CORS）
ALLOWED_ORIGINS=http://localhost:5173,http://device-test.local.yc345.tv

# 是否启用 HTTPS
ENABLE_HTTPS=false

# ==================== 监控配置 ====================

# 是否启用性能监控
ENABLE_MONITORING=true

# 是否启用错误追踪
ENABLE_ERROR_TRACKING=true

# ==================== Redis 配置（可选）====================

# Redis 连接（用于缓存和会话）
# REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=

# ==================== 其他配置 ====================

# 是否启用调试模式
DEBUG=false

# 文件上传大小限制（MB）
MAX_FILE_SIZE=10

# 会话超时时间（分钟）
SESSION_TIMEOUT=30

