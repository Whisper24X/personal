# =========================
# 基础运行配置
# =========================

# 服务端口。前端默认通过 VITE_API_BASE_URL 访问这个地址。
BACKEND_PORT=13000

# 前端访问后端 API 的地址。
VITE_API_BASE_URL=http://localhost:13000/api

# SQLite 数据库文件路径。默认值为 .diting/sqlite/diting.sqlite。
DATABASE_FILE=.diting/sqlite/diting.sqlite


# =========================
# Scheduler / Agent
# =========================

# scheduler tick 间隔，单位毫秒。生产上不建议配得太小。
DITING_SCHEDULER_INTERVAL_MS=30000

# 启动时预创建的 agent 数量。
DITING_SCHEDULER_AGENT_COUNT=2

# agent 心跳超时阈值，单位毫秒。超过后 busy agent 会被判定为 offline。
DITING_SCHEDULER_AGENT_OFFLINE_TIMEOUT_MS=300000


# =========================
# Workspace
# =========================

# task worktree 根目录。
DITING_WORKSPACE_ROOT=.diting/workspaces

# repo bare mirror 缓存目录。
DITING_WORKSPACE_REPO_CACHE_ROOT=.diting/repos

# 执行成功后是否删除 workspace。默认 false，保留完整 repo worktree 与 artifacts。
DITING_WORKSPACE_CLEANUP_ON_SUCCESS=false

# 执行失败后是否删除 workspace。默认 false，排障时会保留完整 repo worktree 与 artifacts。
DITING_WORKSPACE_CLEANUP_ON_FAILURE=false

# 入队前深预检：下载 spec 到临时目录并校验压缩包包含 openspec/；若提供 WORKFLOW_PROMPTS 则校验其内容（默认 false，仅检查元数据与扩展名）。
# DITING_PREFLIGHT_DEEP=false

# spec 附件/压缩包最大字节数（默认 52428800）。
# DITING_SPEC_MAX_BYTES=52428800

# 工作区准备时是否执行 npx openspec 初始化（默认 true；无网络环境可设为 false）。
# DITING_WORKSPACE_OPENSPEC_INIT=true

# 可选高级覆盖：Superpowers skills 安装命令（留空使用服务端内置命令）。
# DITING_WORKSPACE_SUPERPOWERS_INSTALL_CMD=

# OpenSpec / Superpowers 安装超时，单位毫秒（默认 300000）。
# DITING_WORKSPACE_TOOLING_TIMEOUT_MS=300000

# 可选：PR base 分支探测失败时的全局回退（默认按仓 origin/HEAD → main → master）。
# DITING_PR_BASE_BRANCH=


# =========================
# Goal Recovery / Repair Loop
# =========================

# 执行器命令的「墙钟」超时上限，单位毫秒（单次 agent 调用的硬上限兜底）。
DITING_GOAL_EXECUTION_TIMEOUT_MS=7200000

# 执行器命令的「空闲无输出」超时，单位毫秒；超过该时长没有任何 stdout/stderr
# 即判定卡死并杀整进程组（cursor 使用 stream-json 时，正常干活会持续刷新此计时器）。
DITING_GOAL_EXECUTION_IDLE_TIMEOUT_MS=900000

# 质量检查阶段超时，单位毫秒。
DITING_GOAL_QUALITY_TIMEOUT_MS=600000

# 环境准备失败的自动重试次数。
DITING_GOAL_ENVIRONMENT_RETRY_LIMIT=2

# 执行阶段 timeout / launch_error 的自动重试次数。
DITING_GOAL_EXECUTION_RETRY_LIMIT=2

# Goal Loop 最大 repair 轮次。
DITING_GOAL_MAX_REPAIR_ITERATIONS=3

# 是否启用自动 needs_human 闭环。
# false：stop signal 继续 repair，直到 budget exhausted 或成功。
# true：high_risk / repeated_failure / no_effective_diff 可自动转 needs_human，
#      并在插件支持时通过评论回写、读取用户回复后自动恢复。
DITING_GOAL_ENABLE_NEEDS_HUMAN_LOOP=false


# =========================
# 外部插件替换
# =========================

# 按插件类型指定外部插件包名或模块路径。留空时使用内置插件。
# 外部插件包需导出 createPlugin({ serverConfig, pluginKind })。

# 替换任务集成插件，例如 GitHub Issue / Jira / 自定义来源。
# DITING_PLUGIN_TASK_INTEGRATION_PACKAGE=@your-scope/diting-task-integration-plugin

# 替换执行器插件。配置后可把默认 executor 改成该插件支持的 capability。
# DITING_PLUGIN_EXECUTION_PACKAGE=@your-scope/diting-execution-plugin

# 替换环境准备插件。
# DITING_PLUGIN_ENVIRONMENT_PACKAGE=@your-scope/diting-environment-plugin

# 替换 OpenSpec 自动化任务完成度闸门插件。
# DITING_PLUGIN_COMPLETION_GATE_PACKAGE=@your-scope/diting-completion-gate-plugin

# 替换质量检查插件。
# DITING_PLUGIN_QUALITY_PACKAGE=@your-scope/diting-quality-plugin

# 替换治理插件。
# DITING_PLUGIN_OBSERVABILITY_GOVERNANCE_PACKAGE=@your-scope/diting-governance-plugin

# 替换日志插件。
# DITING_PLUGIN_LOG_PACKAGE=@your-scope/diting-log-plugin


# =========================
# 执行器配置
# =========================

# 未显式指定 executor 的任务默认执行器。
# 内置执行器可选 codex / cursor。
# 若使用外部 execution 插件，这里填写该插件支持的 capability 名称。
DITING_DEFAULT_EXECUTOR=codex

# Codex CLI 可执行文件名或绝对路径。
DITING_PLUGIN_EXECUTION_CODEX_BIN=codex

# Cursor CLI 可执行文件名或绝对路径。
DITING_PLUGIN_EXECUTION_CURSOR_BIN=agent


# =========================
# Meegle 集成
# =========================

# 集成模式：
# polling  通过文件或 CLI 主动拉取任务
# webhook  通过 HTTP webhook 接收任务
DITING_PLUGIN_MEEGLE_MODE=polling

# Meegle CLI 可执行文件名或绝对路径。
MEEGLE_CLI_BIN=meegle

# 任务来源模式：
# latest_sprint 表示按“最新迭代 -> 需求”链路拉取
# 留空则走 queryMql 或默认 CLI 流程
MEEGLE_SOURCE_MODE=latest_sprint

# Meegle 设备码登录时可指定 host。
# MEEGLE_AUTH_HOST=

# Meegle CLI profile 名称。多账号隔离时有用。
# MEEGLE_AUTH_PROFILE=

# 项目标识。CLI 拉取 / 评论写回常用。
MEEGLE_PROJECT_KEY=

# latest_sprint 模式所需配置。
MEEGLE_PROJECT_SCOPE_NAME=
MEEGLE_SPRINT_TYPE_NAME=
MEEGLE_DEMAND_TYPE_NAME=
MEEGLE_SPRINT_LINK_FIELD=

# latest_sprint 模式下可选的节点名过滤，例如“开发中”；子任务修复闭环也会用此节点名定位开发节点。
MEEGLE_NODE_NAME=

# Meegle 子任务「子任务描述」字段 field_key，例如 field_c2b4ee；留空则按字段名「子任务描述」解析。
MEEGLE_CHILD_TASK_DESCRIPTION_FIELD_KEY=field_c2b4ee

# latest_sprint 模式下按飞书角色「板子R」过滤需求。
# 推荐配置角色成员邮箱，服务会在详情阶段按 role_members 精确过滤，避免同名用户导致 MQL 失败。
MEEGLE_BOARD_USER_EMAIL=yangdong2@guanghe.tv
# 兼容旧方式：配置角色成员显示名，例如“晏嘉琳”。未配置 MEEGLE_BOARD_USER_EMAIL 时才会参与 MQL 过滤。
MEEGLE_BOARD_VALUE=
# 若角色名不是默认「板子R」才需要覆盖：
# MEEGLE_BOARD_FIELD=板子R

# 自定义 MQL 查询。latest_sprint 模式下通常可留空。
MEEGLE_QUERY_MQL=

# workitem detail 拉取字段列表，逗号分隔（服务端会自动追加 spec文档 等附件字段）。
MEEGLE_DETAIL_FIELDS=repo,branch,instruction,priority,description,title,spec文档

# latest_sprint 明细字段列表，逗号分隔（同样会自动追加 spec文档；仅写 description 也会拉 spec）。
MEEGLE_LATEST_SPRINT_DETAIL_FIELDS=description

# Optional extra Meegle field_key(s) for spec zip (display name spec文档; internal key from meta-fields / MQL)
MEEGLE_SPEC_FIELD_KEYS=field_5fffe2,spec文档

# 文件型 polling 任务源。配置后会直接读取本地 JSON 文件。
# DITING_PLUGIN_MEEGLE_TASKS_FILE=/absolute/path/to/.diting/meegle/tasks.json

# 文件型结果回写。仅当同时配置 tasks file 时有效。
# DITING_PLUGIN_MEEGLE_RESULTS_FILE=/absolute/path/to/.diting/meegle/results.json

# webhook 模式下的共享密钥。
# DITING_PLUGIN_MEEGLE_WEBHOOK_SECRET=


# =========================
# GitLab CLI 集成
# =========================

# GitLab CLI 可执行文件名或绝对路径。
GITLAB_CLI_BIN=glab

# GitLab host，用于 `glab auth status --hostname` 与授权流程。
DITING_GITLAB_HOST=gitlab.yc345.tv


# =========================
# Governance
# =========================

# 命令 allowlist，逗号分隔。留空表示不启用 allowlist。
DITING_GOVERNANCE_ALLOW_COMMAND_PREFIXES=

# 危险命令正则 blocklist，逗号分隔。
DITING_GOVERNANCE_BLOCK_COMMAND_PATTERNS=\\bgit\\s+push\\b,\\brm\\s+-rf\\s+/,\\bterraform\\s+destroy\\b,\\baws\\s+iam\\b,\\bssh\\b,\\bscp\\b

# 单次命令 prompt 最大字符数。
DITING_GOVERNANCE_MAX_PROMPT_CHARS=16000

# stdout/stderr 最大保留字符数。
DITING_GOVERNANCE_MAX_OUTPUT_CHARS=12000

# diff 中文件数阈值，超过后治理会升级风险。
DITING_GOVERNANCE_MAX_FILES_CHANGED=20

# diff 行数阈值，超过后治理会升级风险。
DITING_GOVERNANCE_MAX_DIFF_LINES=400
