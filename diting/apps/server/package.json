{
  "name": "@diting/server",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json --incremental false",
    "diagnose:task": "node --require ts-node/register src/diting/diagnose-task.ts",
    "migration:legacy": "node --require ts-node/register src/migrate-legacy.ts",
    "migration:run": "node dist/apps/server/src/run-migrations.js",
    "smoke:sqlite": "node --require ts-node/register src/diting/sqlite-smoke.ts",
    "start": "node dist/apps/server/src/main.js",
    "start:dev": "node --require ts-node/register src/main.ts",
    "test": "jest",
    "type-check": "tsc --noEmit -p tsconfig.build.json"
  },
  "dependencies": {
    "@diting/core": "0.1.0",
    "@diting/plugin-api": "0.1.0",
    "@fastify/cors": "^11.2.0",
    "fastify": "^5.8.5",
    "playwright": "^1.61.1",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
