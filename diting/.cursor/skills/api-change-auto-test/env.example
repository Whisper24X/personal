# 可选：工作区根目录（默认当前执行目录）
export SKILL_WORKSPACE_ROOT=""

# 直连模式（默认 true；Agent 起服后由 write-env-local.mjs 写入）
export RUNNER_DIRECT_MODE="true"

# 直连模式下的服务地址
export RUNNER_BASE_URL="http://127.0.0.1:8000"

# 可选：显式指定 docker 容器名时才走 docker 模式
export RUNNER_CONTAINER_NAME=""

# 可选：runner 网关前缀（通常是 /api）
export RUNNER_GATEWAY_PREFIX="/api"

# 鉴权头（admin / client 双通道；按需填写）
# export RUNNER_ADMIN_AUTH_HEADER="authorization: Bearer <admin-token>"
# export RUNNER_CLIENT_AUTH_HEADER="authorization: Bearer <client-token>"
# legacy 名仍兼容：
# export RUNNER_SHADOW_AUTH_HEADER="authorization: Bearer <admin-token>"
# export RUNNER_WECHAT_AUTH_HEADER="authorization: Bearer <client-token>"

# 测试策略
export RUNNER_TEST_STRICT="false"
export RUNNER_ALLOW_UNAUTH="false"
export RUNNER_REQUEST_TIMEOUT_MS="30000"
export APIFOX_SMOKE_MAX_ENDPOINTS="4"
export APIFOX_SMOKE_KEYWORDS="create,save,publish,info,update_status,list"

# 项目级配置：skills/api-change-auto-test/api-test/runtime.json（鉴权 classify + 后端起服）
