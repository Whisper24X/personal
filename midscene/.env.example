# 自动化配置
# 请复制此文件为 .env 并填入你的配置
# cp .env.example .env

# ============================================================
# Cursor CLI / Agent 配置（用于 Cursor CLI 模式自动化）
# 适用于: cursor agent、Engineer 角色、非浏览器类自动化
# 参考: https://cursor.com/docs/cli
# ============================================================
CURSOR_API_KEY=crsr_99a96ce915369f73a8eedf8014c87255ddeb39eedaee55b4defcaed47f62e394

# 默认执行模式: llm | cli
DEFAULT_EXECUTOR_MODE=cli

# 默认 CLI 提供商: cursor | aider | cline | custom
DEFAULT_CLI_PROVIDER=cursor

# Cursor CLI 配置
CURSOR_CLI_MODEL=composer-1.5
CURSOR_CLI_TIMEOUT=3600000
ROLE_ENGINEER_CLI_MODEL=composer-1.5

# ============================================================
# Midscene 视觉模型配置（用于浏览器 UI 自动化）
# 注意: Cursor API 不提供 OpenAI 兼容的视觉模型接口，
# 浏览器自动化必须配置以下视觉模型之一
# 参考: https://midscenejs.com/model-common-config.html
# ============================================================

# ========== 阿里云通义千问 Qwen3-VL (推荐) ==========
# MIDSCENE_MODEL_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
# MIDSCENE_MODEL_API_KEY="your-dashscope-api-key"
# MIDSCENE_MODEL_NAME="qwen3-vl-plus"
# MIDSCENE_MODEL_FAMILY="qwen3-vl"

# ========== 豆包 Doubao Seed (火山引擎) ==========
# MIDSCENE_MODEL_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"
# MIDSCENE_MODEL_API_KEY="your-volcano-api-key"
# MIDSCENE_MODEL_NAME="ep-xxxxx"
# MIDSCENE_MODEL_FAMILY="doubao-seed"

# ========== 智谱 GLM (BigModel 国内) ==========
# 注意: Midscene 需要视觉模型，请使用 glm-4.5v 或 glm-4.6v，不能用 glm-4.5-air（纯文本）
# MIDSCENE_MODEL_BASE_URL="https://open.bigmodel.cn/api/paas/v4"
# MIDSCENE_MODEL_API_KEY="your-bigmodel-api-key"
# MIDSCENE_MODEL_NAME="glm-4.5v"
# MIDSCENE_MODEL_FAMILY="glm-v"

# ========== 智谱 GLM-4.6V (Z.AI 国际 / BigModel) ==========
# MIDSCENE_MODEL_BASE_URL="https://api.z.ai/api/paas/v4"
# MIDSCENE_MODEL_API_KEY="your-zai-api-key"
# MIDSCENE_MODEL_NAME="glm-4.6v"
# MIDSCENE_MODEL_FAMILY="glm-v"

# ========== DeepSeek（自建/代理网关，OpenAI 兼容）==========
# MIDSCENE_MODEL_BASE_URL="https://ops-ai-gateway.yc345.tv/v1"
# MIDSCENE_MODEL_API_KEY="your-api-key"
# MIDSCENE_MODEL_NAME="deepseek-v3-2-251201"
# MIDSCENE_MODEL_FAMILY="qwen3-vl"

# ========== Google Gemini 3.1 Flash ==========
# MIDSCENE_MODEL_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
# MIDSCENE_MODEL_API_KEY="your-gemini-api-key"
# MIDSCENE_MODEL_NAME="gemini-3.1-flash"
# MIDSCENE_MODEL_FAMILY="gemini"
