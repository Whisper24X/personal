{
  "name": "trip-miniprogram",
  "version": "1.0.0",
  "private": true,
  "description": "研学小程序",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "Less",
    "framework": "Vue3"
  },
  "scripts": {
    "build:weapp": "taro build --type weapp --mode development",
    "build:weapp:local": "taro build --type weapp --mode local",
    "build:weapp:test": "taro build --type weapp --mode test",
    "build:weapp:stage": "taro build --type weapp --mode stage",
    "build:weapp:production": "taro build --type weapp --mode production",
    "build:swan": "taro build --type swan",
    "build:alipay": "taro build --type alipay",
    "build:tt": "taro build --type tt",
    "build:h5": "BROWSERSLIST_ENV=production taro build --type h5",
    "build:h5:local": "BROWSERSLIST_ENV=production taro build --type h5 --mode local",
    "build:rn": "taro build --type rn",
    "build:qq": "taro build --type qq",
    "build:jd": "taro build --type jd",
    "build:harmony-hybrid": "taro build --type harmony-hybrid",
    "dev:weapp": "npm run build:weapp -- --watch",
    "dev:weapp:local": "npm run build:weapp:local -- --watch",
    "dev:swan": "npm run build:swan -- --watch",
    "dev:alipay": "npm run build:alipay -- --watch",
    "dev:tt": "npm run build:tt -- --watch",
    "dev:h5": "npm run build:h5 -- --watch",
    "dev:h5:local": "npm run build:h5:local -- --watch",
    "dev:rn": "npm run build:rn -- --watch",
    "dev:qq": "npm run build:qq -- --watch",
    "dev:jd": "npm run build:jd -- --watch",
    "dev:harmony-hybrid": "npm run build:harmony-hybrid -- --watch",
    "prepare": "husky install",
    "lint": "eslint --ext .js,.ts,.vue src",
    "lint:fix": "eslint --ext .js,.ts,.vue src --fix",
    "format": "prettier --write \"src/**/*.{js,ts,vue,less,scss}\"",
    "format:fix": "npm run lint:fix && npm run format",
    "commitlint": "commitlint --config commitlint.config.js -e",
    "ci:weapp:open": "taro build --type weapp --open",
    "ci:weapp:preview": "taro build --type weapp --preview",
    "ci:weapp:upload": "taro build --type weapp --upload",
    "ci:weapp:upload:test": "taro build --type weapp --mode test --upload",
    "ci:weapp:upload:stage": "taro build --type weapp --mode stage --upload",
    "ci:weapp:upload:production": "taro build --type weapp --mode production --upload"
  },
  "browserslist": {
    "development": [
      "last 1 Chrome version",
      "last 1 Firefox version",
      "last 1 Safari version"
    ],
    "production": [
      "last 3 versions",
      "Android >= 4.1",
      "ios >= 8"
    ]
  },
  "author": "",
  "dependencies": {
    "@babel/runtime": "^7.24.4",
    "@guanghe-pub/yc-upload": "^0.3.3",
    "@huolala-tech/page-spy-taro": "^2.2.4",
    "@huolala-tech/page-spy-wechat": "^2.2.4",
    "@tarojs/components": "4.0.9",
    "@tarojs/helper": "4.0.9",
    "@tarojs/plugin-framework-vue3": "4.0.9",
    "@tarojs/plugin-platform-alipay": "4.0.9",
    "@tarojs/plugin-platform-h5": "4.0.9",
    "@tarojs/plugin-platform-harmony-hybrid": "4.0.9",
    "@tarojs/plugin-platform-jd": "4.0.9",
    "@tarojs/plugin-platform-qq": "4.0.9",
    "@tarojs/plugin-platform-swan": "4.0.9",
    "@tarojs/plugin-platform-tt": "4.0.9",
    "@tarojs/plugin-platform-weapp": "4.0.9",
    "@tarojs/runtime": "4.0.9",
    "@tarojs/shared": "4.0.9",
    "@tarojs/taro": "4.0.9",
    "pinia": "^3.0.1",
    "pinia-plugin-persistedstate": "^4.2.0",
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
    "@babel/plugin-proposal-class-properties": "7.14.5",
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@tarojs/cli": "4.0.9",
    "@tarojs/plugin-inject": "^4.1.6",
    "@tarojs/plugin-mini-ci": "^4.0.12",
    "@tarojs/vite-runner": "4.0.9",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vitejs/plugin-vue-jsx": "^3.1.0",
    "autoprefixer": "^10.4.21",
    "babel-preset-taro": "4.0.9",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.1",
    "eslint-config-taro": "4.0.9",
    "eslint-plugin-prettier": "^5.2.5",
    "eslint-plugin-vue": "^9.33.0",
    "husky": "^8.0.0",
    "install": "^0.13.0",
    "less": "^4.2.0",
    "lint-staged": "^15.5.0",
    "miniprogram-ci": "1.9.17",
    "postcss": "^8.4.38",
    "postcss-pxtorem": "^6.1.0",
    "postcss-viewport-units": "^0.1.6",
    "prettier": "^3.5.3",
    "stylelint": "^16.4.0",
    "terser": "^5.30.4",
    "typescript": "^5.4.5",
    "vite": "^4.5.10"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,less,scss}": [
      "prettier --write"
    ]
  }
}
