# Apifox CLI 环境变量配置示例
# 复制此文件为 .env，填入实际值（.env 已加入 .gitignore 不会提交）

# ========== 测试环境地址 ==========
# 测试环境 Base URL
API_BASE_URL=https://device-test-api.yangcong345.com

# ========== Apifox 配置 ==========
# Apifox Access Token
# 获取路径：Apifox 客户端 → 头像 → 账号设置 → API 访问令牌
APIFOX_ACCESS_TOKEN=your_access_token_here

# 项目 ID（从 Apifox 项目 URL 中获取）
APIFOX_PROJECT_ID=

# 测试场景 ID（从 Apifox 自动化测试 → CI/CD 面板复制命令中获取）
APIFOX_TEST_SCENARIO_ID=

# 运行环境 ID（对应 Apifox 中配置的「测试环境」）
APIFOX_ENVIRONMENT_ID=
