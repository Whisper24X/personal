# ============================================================
# AINative Workspace Sandbox 配置
# ============================================================

# ---- 容器 ----
# 项目标识：用于生成镜像名、容器名、分组名、volume 前缀
# 复制到其他项目时只需修改此值
SANDBOX_PROJECT=yanxue-main

# SANDBOX_NAME 和 SANDBOX_PORT 由 sandbox.sh 根据分支名自动推导
# 如需手动覆盖，取消注释以下两行：
# SANDBOX_NAME=自定义容器名
SANDBOX_PORT=8080
SANDBOX_MEMORY=4g

# ---- PostgreSQL ----
PG_HOST=10.8.8.110
PG_PORT=5433
PG_USER=postgres
PG_PASSWORD=7to12pg12
PG_DB=yanxue

# ---- Redis ----
REDIS_ADDR=10.8.8.117:6379
REDIS_PASSWORD=

# ---- Nacos ----
NACOS_SD_HOST=10.88.119.69
NACOS_SD_PORT=8848
NACOS_SD_ACCOUNT=nacos
NACOS_SD_PASSWD=unitednac

# ---- Kafka ----
KAFKA_ADDR=10.8.8.207:9092
KAFKA_USER=
KAFKA_PASSWORD=

# ---- RabbitMQ ----
RABBIT_ENDPOINT=10.8.8.14
RABBIT_USERNAME=admin
