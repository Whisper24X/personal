# 复制为 backend/.env.development 后按需修改。
# 与仓库根目录 docker-compose.yml 中 postgres/redis 一致（本机跑 Nest + Docker 起库）。
# 若只是覆盖你机器上的连接参数，优先放到 `.env.local`，不要改共享默认值。

NODE_ENV=development
# docker-compose backend 映射为 9000；本机直连前端代理时常用 9000
APP_PORT=9000
APP_NAME="NestJS API"
API_PREFIX=api
APP_FALLBACK_LANGUAGE=en
APP_HEADER_LANGUAGE=x-custom-lang
FRONTEND_DOMAIN=http://localhost:8000
BACKEND_DOMAIN=http://localhost:9000

DATABASE_TYPE=postgres
# 本机 npm run start:dev：连映射端口用 localhost；仅在 backend 容器内跑时用 postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=123456
DATABASE_NAME=ainative
DATABASE_SYNCHRONIZE=false
DATABASE_LOGGING=false
DATABASE_MAX_CONNECTIONS=100
DATABASE_SSL_ENABLED=false
DATABASE_REJECT_UNAUTHORIZED=false
DATABASE_CA=
DATABASE_KEY=
DATABASE_CERT=
# 若设置 DATABASE_URL，将覆盖上方 DATABASE_*（需与 docker-compose 中账号库名一致）
DATABASE_URL=

AUTH_JWT_SECRET=secret
AUTH_JWT_TOKEN_EXPIRES_IN=15m
AUTH_REFRESH_SECRET=secret_for_refresh
AUTH_REFRESH_TOKEN_EXPIRES_IN=3650d

AINATIVE_DISPATCH_INTERVAL_MS=1000
AINATIVE_NODE_LEASE_TTL_MS=45000
AINATIVE_NODE_HEARTBEAT_INTERVAL_MS=10000
AINATIVE_STALE_RECOVERY_INTERVAL_MS=15000
AINATIVE_STREAM_DB_POLL_INTERVAL_MS=1000
AINATIVE_GIT_RUNTIME_ENABLED=false
AINATIVE_AGENT_RUNNER_ENABLED=false
AINATIVE_REPO_CACHE_BASE_DIR=
AINATIVE_WORKTREE_BASE_DIR=
AINATIVE_WORKTREE_ALLOWED_ROOT=
AINATIVE_DATA_ROOT_DIR=./tmp
AINATIVE_CODEX_RUNNER_COMMAND=
AINATIVE_CURSOR_RUNNER_COMMAND=
AINATIVE_CLAUDE_RUNNER_COMMAND=
AINATIVE_GEMINI_RUNNER_COMMAND=
AINATIVE_OPENCODE_RUNNER_COMMAND=

# 与 docker-compose redis requirepass 一致；本机连映射端口用 localhost
WORKER_HOST=redis://:123456@localhost:6379/1
MAIL_PORT=1025
MAIL_CLIENT_PORT=1080
