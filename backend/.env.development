# ─── 应用 ───
NODE_ENV=development
APP_PORT=9000
APP_NAME="AINative API"
API_PREFIX=api
APP_FALLBACK_LANGUAGE=en
APP_HEADER_LANGUAGE=x-custom-lang
HTTP_ACCESS_LOGGING_ENABLED=true
SLOW_API_DIAGNOSTICS_ENABLED=true

# ─── 跨域 ───
FRONTEND_DOMAIN=http://localhost:8000
BACKEND_DOMAIN=http://localhost:9000

# ─── 数据库 ───
DATABASE_TYPE=postgres
DATABASE_HOST=10.8.8.110
DATABASE_PORT=5433
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=7to12pg12
DATABASE_NAME=ainative
DATABASE_URL=
DATABASE_SYNCHRONIZE=false
DATABASE_LOGGING=false
DATABASE_MAX_CONNECTIONS=100
# SSL（生产环境按需启用）
DATABASE_SSL_ENABLED=false
DATABASE_REJECT_UNAUTHORIZED=false
DATABASE_CA=
DATABASE_KEY=
DATABASE_CERT=

# ─── 认证 ───
AUTH_JWT_SECRET=secret
AUTH_JWT_TOKEN_EXPIRES_IN=15m
AUTH_REFRESH_SECRET=secret_for_refresh
AUTH_REFRESH_TOKEN_EXPIRES_IN=3650d

# ─── 任务调度 ───
AINATIVE_DISPATCH_INTERVAL_MS=1000
AINATIVE_NODE_LEASE_TTL_MS=45000
AINATIVE_NODE_HEARTBEAT_INTERVAL_MS=10000
AINATIVE_STALE_RECOVERY_INTERVAL_MS=15000
AINATIVE_STREAM_DB_POLL_INTERVAL_MS=1000
AINATIVE_WORKTREE_ALLOWED_ROOT=
AINATIVE_DATA_ROOT_DIR=../tmp
AINATIVE_PROJECT_MAX_CONTAINERS_PER_PROJECT=1
AINATIVE_TASK_SANDBOX_PROFILE=preview-web
AINATIVE_RUNNER_PLATFORM=linux/amd64
AINATIVE_RUNNER_NETWORK_MODE=bridge
AINATIVE_RUNNER_EXPOSE_HOST_IP=192.168.2.46
# 预览页对外访问基础地址；最终地址会拼接运行时端口，例如 https://preview.example.com
AINATIVE_PREVIEW_BASE_URL=http://10.8.8.152
AINATIVE_RUNNER_EXPOSE_CONTAINER_PORT=8080
AINATIVE_RUNNER_EXPOSE_PORT_RANGE_START=39130
AINATIVE_RUNNER_EXPOSE_PORT_RANGE_END=39160
# ─── Redis / BullMQ ───
# 与 configs/test.yaml redis.yanxue 一致：10.8.8.117:6379，db 7
WORKER_HOST=redis://10.8.8.117:6379/7
