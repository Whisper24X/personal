NODE_ENV=production
APP_PORT=3000
APP_NAME=AINative API
API_PREFIX=api
APP_FALLBACK_LANGUAGE=en
APP_HEADER_LANGUAGE=x-custom-lang
FRONTEND_DOMAIN=http://localhost:8090
BACKEND_DOMAIN=http://localhost:8000

DATABASE_TYPE=postgres
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=ainative
DATABASE_SYNCHRONIZE=false
DATABASE_MAX_CONNECTIONS=100
DATABASE_SSL_ENABLED=false
DATABASE_REJECT_UNAUTHORIZED=false

AUTH_JWT_SECRET=secret
AUTH_JWT_TOKEN_EXPIRES_IN=15m
AUTH_REFRESH_SECRET=secret_for_refresh
AUTH_REFRESH_TOKEN_EXPIRES_IN=3650d

AINATIVE_DISPATCH_INTERVAL_MS=1000
AINATIVE_NODE_LEASE_TTL_MS=45000
AINATIVE_NODE_HEARTBEAT_INTERVAL_MS=10000
AINATIVE_STALE_RECOVERY_INTERVAL_MS=15000
AINATIVE_RETENTION_CLEANUP_INTERVAL_MS=3600000
AINATIVE_STREAM_DB_POLL_INTERVAL_MS=1000
AINATIVE_GIT_RUNTIME_ENABLED=false
AINATIVE_AGENT_RUNNER_ENABLED=false
AINATIVE_RUN_SEED=true

WORKER_HOST=redis://:redis@redis:6379/1
