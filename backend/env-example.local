# 复制为 backend/.env.local 后按需修改。
# 该文件用于本机私有覆写，会覆盖 `.env` 或 `.env.development` 中的同名变量。
# 推荐只放你机器相关的差异项，不要整份复制共享配置。

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=
DATABASE_NAME=ainative

WORKER_HOST=redis://:password@localhost:6379/1

AINATIVE_DATA_ROOT_DIR=../tmp
