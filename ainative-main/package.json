{
  "name": "mind2build",
  "version": "1.0.0",
  "description": "Mind2Build - Multi-Agent Collaboration Framework",
  "private": true,
  "scripts": {
    "dev:backend": "pnpm --filter @mind2build/backend dev",
    "dev:frontend": "pnpm --filter @mind2build/frontend dev",
    "build": "pnpm --filter @mind2build/shared build && pnpm --filter @mind2build/backend build && pnpm --filter @mind2build/frontend build",
    "build:shared": "pnpm --filter @mind2build/shared build",
    "build:backend": "pnpm --filter @mind2build/backend build",
    "build:frontend": "pnpm --filter @mind2build/frontend build",
    "start:backend": "pnpm --filter @mind2build/backend start",
    "test": "pnpm --filter @mind2build/backend test",
    "lint": "pnpm --filter @mind2build/backend lint && pnpm --filter @mind2build/frontend lint",
    "lint:fix": "pnpm --filter @mind2build/backend lint:fix && pnpm --filter @mind2build/frontend lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,vue,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,vue,json,md}\"",
    "commit": "cz",
    "db:migrate": "pnpm --filter @mind2build/backend db:migrate",
    "db:seed": "pnpm --filter @mind2build/backend db:seed",
    "db:init-llm": "pnpm --filter @mind2build/backend db:init-llm",
    "pm2:start": "./scripts/pm2-start.sh",
    "pm2:start:dev": "./scripts/dev.sh",
    "pm2:start:direct": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:reload": "pm2 reload ecosystem.config.js",
    "pm2:delete": "pm2 delete ecosystem.config.js",
    "pm2:logs": "pm2 logs",
    "pm2:monit": "pm2 monit",
    "pm2:status": "pm2 status",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "lint-staged": {
    "backend/**/*.{ts,js}": [
      "pnpm --filter @mind2build/backend exec eslint --fix",
      "prettier --write"
    ],
    "frontend/**/*.{ts,tsx,js,jsx,vue}": [
      "pnpm --filter @mind2build/frontend exec eslint --fix",
      "prettier --write"
    ],
    "shared/**/*.{ts,js}": [
      "prettier --write"
    ],
    "**/*.{json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  }
}
