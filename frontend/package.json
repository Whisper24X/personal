{
  "name": "@mind2build/frontend",
  "version": "1.0.0",
  "description": "Mind2Build Frontend - Vue 3 + Vite",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts",
    "lint:fix": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "format": "prettier --write \"src/**/*.{vue,ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{vue,ts,tsx,js,jsx,json,md}\"",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@vueuse/core": "^10.7.1",
    "axios": "^1.6.5",
    "element-plus": "^2.13.0",
    "markdown-it": "^14.1.0",
    "pinia": "^2.1.7",
    "vue": "^3.4.5",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.16.0",
    "@typescript-eslint/parser": "^6.16.0",
    "@vitejs/plugin-vue": "^5.0.2",
    "@vue/eslint-config-prettier": "^9.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "eslint": "^8.56.0",
    "eslint-plugin-vue": "^9.19.2",
    "prettier": "^3.1.1",
    "sass-embedded": "^1.97.3",
    "typescript": "^5.3.3",
    "vite": "^5.0.11",
    "vue-tsc": "^3.2.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
